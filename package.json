{
  "name": "allinone-dsh-mobile",
  "version": "1.0.32",
  "private": true,
  "license": "MIT",
  "description": "All in One — Self-hosted cross-device control center (Mobile PWA / Electron Desktop / PC Bridge) for DeepSeek Harness, Codex, Claude Code, and Antigravity.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RainbowLion0320/AllinOne.git"
  },
  "homepage": "https://github.com/RainbowLion0320/AllinOne#readme",
  "bugs": {
    "url": "https://github.com/RainbowLion0320/AllinOne/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:relay": "npm --workspace=@allinone/relay-server run dev",
    "start:relay": "npm --workspace=@allinone/relay-server run start",
    "dev:bridge": "npm --workspace=dsh-mobile-hub run standalone",
    "dev:mobile": "npm --workspace=@allinone/mobile-app run dev",
    "build:bridge": "node scripts/build-portable-bridge.mjs",
    "build:mobile": "npm --workspace=@allinone/mobile-app run build",
    "build": "npm run build:bridge && npm run build:mobile",
    "dev:desktop": "npm --workspace=@allinone/desktop-app run dev",
    "pack:mac": "npm --workspace=@allinone/desktop-app run pack:mac",
    "pack:win": "npm --workspace=@allinone/desktop-app run pack:win",
    "prepare:android": "npm --workspace=@allinone/mobile-app run prepare:android",
    "admin": "node packages/relay-server/src/admin-cli.js",
    "lint": "eslint .",
    "version:check": "node scripts/bump-version.mjs --check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test": "npm run test:unit && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
