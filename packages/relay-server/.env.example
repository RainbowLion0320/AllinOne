# Relay Server 环境变量配置（复制为 .env 后修改密钥）
PORT=8787
HOST=0.0.0.0

# 手机 App 登录密钥（请修改为你自己的高强度口令）
CLIENT_ACCESS_TOKEN=change-me-mobile-password

# PC 端 dsh-mobile-hub 连接本服务器的独立密钥（请修改为你自己的高强度随机串）
BRIDGE_SECRET=change-me-bridge-secret

# 用于签发手机端 Session Token 的密钥（留空则基于 CLIENT_ACCESS_TOKEN + BRIDGE_SECRET 派生）
JWT_SECRET=

# 可选：公网访问地址（用于 /setup.ps1 与 /setup.sh 自动注入服务器 URL，以及 CORS/WS Origin 白名单，例如 https://ai.yourdomain.com）
PUBLIC_RELAY_URL=

# 可选：房间注册邀请码（设置后 /api/rooms/register 必须携带匹配邀请码，防止公网陌生人滥用注册）
REGISTER_INVITE_CODE=

# 可选：额外允许跨域访问的浏览器 Origin（逗号分隔）
ALLOWED_ORIGINS=

# 可选：自定义手机前端静态资源目录（默认自动寻找 ../mobile-app/dist）
STATIC_DIR=

# 可选：临时附件中转目录（默认 ./data/uploads）
UPLOAD_DIR=

# 可选：前端构建参数（用于自托管编译时注入默认地址与自定义 Android APK 下载地址）
# VITE_RELAY_URL=https://ai.yourdomain.com
# VITE_APK_URL=https://github.com/your-org/AllinOne/releases/latest

