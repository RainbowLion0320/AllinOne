# Relay Server 环境变量配置（复制为 .env 后修改密钥）
PORT=8787
HOST=0.0.0.0

# 用于签发账号 Session Token 的高强度随机密钥（生产环境必填，至少 16 字符，建议 32+ 随机 hex）
# 可运行 `openssl rand -hex 32` 生成
JWT_SECRET=
# 可选：密钥平滑轮换时的旧密钥（轮换期间允许验证旧 30 天 Token，新签发统一使用 JWT_SECRET）
# JWT_SECRET_PREVIOUS=

# 可选：首次部署尚无任何账号时，用于在注册页一次性创建首个管理员账号的初始化密钥
# 留空则首个注册的用户自动成为管理员；设置后首个管理员注册必须提供此密钥
ADMIN_BOOTSTRAP_TOKEN=

# 每日新用户开放注册上限（默认 20 人/天；设为 0 表示不限制每日注册人数）
MAX_DAILY_REGISTRATIONS=20
# 单 IP 每日最多注册新账号数（默认 5；防止单 IP 刷爆全站每日配额，设为 0 不限）
MAX_REGISTRATIONS_PER_IP_PER_DAY=5

# 可选：公网访问地址（用于 /setup.ps1 与 /setup.sh 自动注入服务器 URL，以及 CORS/WS Origin 白名单，例如 https://ai.yourdomain.com）
PUBLIC_RELAY_URL=

# 可选：额外允许跨域访问的浏览器 Origin（逗号分隔）
ALLOWED_ORIGINS=

# 可选：信任的反向代理来源（默认 loopback；Docker+Caddy/Nginx 同网桥请设 private；禁用设 none）
# TRUST_PROXY=loopback
# 可选：代理 IP 头策略（默认优先 X-Forwarded-For 最右非信任跳；设为 x-forwarded-for 彻底忽略 X-Real-IP）
# TRUST_PROXY_HEADER=

# 可选：结构化 JSON 日志（设为 json 输出 NDJSON，默认人类可读文本）
# LOG_FORMAT=text

# 可选：自定义手机前端静态资源目录（默认自动寻找 ../mobile-app/dist）
STATIC_DIR=

# 可选：自定义账号数据文件 JSON 路径（默认 ./data/accounts.json）
# ACCOUNTS_FILE=

# 可选：覆盖自动生成的 ICE/STUN/TURN 服务器列表（逗号分隔 URL，例如 stun:stun.cloudflare.com:3478）
# ICE_SERVERS=

# 可选：内置无状态 STUN UDP 端口（默认 3478；如本机已安装 coturn 占用 3478，请设为 off）
# STUN_PORT=3478

# 可选：自建 coturn 动态临时凭证与按用户分级月度中继配额（仅双对称 NAT 无法直连时自动启用加密 TURN 中继，P2P 直连永久无限 0 流量）
# 与 /etc/turnserver.conf 的 static-auth-secret 及 log-file 保持一致；ultra 与 admin 共用同一套配额规则，设为 0 表示不限量
# TURN_HOST=your-domain-or-public-ip
# TURN_PORT=3478
# TURN_SECRET=
# TURN_TTL_SEC=600
# TURN_LOG_FILE=/var/log/coturn/turn.log
# TURN_QUOTA_FREE_MB=1024
# TURN_QUOTA_PRO_MB=10240
# TURN_QUOTA_ULTRA_MB=51200

# 可选：分级中继线路（将指定等级路由至 Cloudflare Realtime TURN 免费 1 TB/月 公共池，0 消耗自有 VPS 流量）
# 默认仅 free 档走 Cloudflare，pro / ultra / admin 继续走自建国内低延迟专线；
# CF_TURN_FALLBACK_SELF_HOSTED=false 可在 Cloudflare 不可用时禁止 free 档回落自建 coturn（严格保护 VPS 流量）
# CF_TURN_TOKEN_ID=
# CF_TURN_API_TOKEN=
# CF_TURN_TIERS=free
# CF_TURN_TTL_SEC=3600
# CF_TURN_FALLBACK_SELF_HOSTED=true

# 可选：免费邮箱验证、登录 2FA 与自助找回密码（留空则默认关闭，用户仅用用户名+密码注册）
# 支持任意标准 SMTP 服务（如 QQ 邮箱 smtp.qq.com / 163 邮箱 smtp.163.com / Gmail smtp.gmail.com，推荐 465 端口 SSL）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@qq.com
# SMTP_PASS=your-smtp-auth-code
# SMTP_FROM=All in One <your-email@qq.com>
#
# 或使用 Resend HTTPS API（需绑定自有域名，免费额度 3000 封/月）：
# RESEND_API_KEY=
# RESEND_FROM=All in One <noreply@yourdomain.com>

# 可选：前端构建参数（用于自托管编译时注入默认地址与自定义 Android APK 下载地址）
# VITE_RELAY_URL=https://ai.yourdomain.com
# VITE_APK_URL=All-in-One-Android.apk
